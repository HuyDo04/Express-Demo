<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .forgot-password-container {
            background: #fff;
            padding: 32px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
        }

        .forgot-password-title {
            color: #333;
            margin-bottom: 20px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
        }

        .forgot-password-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .forgot-password-input {
            padding: 12px 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .forgot-password-input:focus {
            border-color: #007bff;
        }

        .forgot-password-button {
            padding: 12px 14px;
            background: #007bff;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .forgot-password-button:hover {
            background: #0056b3;
        }

        .forgot-password-message {
            color: red;
            margin-bottom: 16px;
            text-align: center;
        }
    </style>
</head>  

<body class="forgot-password-page">

    <% if (message) { %>
        <p class="forgot-password-message">
            <%= message %>
        </p>
        <% } %>
    <h1 class="forgot-password-title">Quên mật khẩu</h1>


            <form action="/admin/forgotPassword" method="POST" class="forgot-password-form">
                <input type="email" name="email" placeholder="Nhập email của bạn" required
                    class="forgot-password-input" />
                <button type="submit" class="forgot-password-button">Xác thực bằng email</button>
            </form>
</body>

</html>