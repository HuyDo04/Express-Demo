<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <title>Đặt lại mật khẩu</title>
    <style>
        .reset-password-page {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .reset-password-title {
            color: #333;
            margin-bottom: 20px;
        }

        .reset-password-form {
            background: #fff;
            padding: 24px 32px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .reset-password-input {
            padding: 12px 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .reset-password-input:focus {
            border-color: #007bff;
        }

        .reset-password-button {
            padding: 12px 14px;
            background: #007bff;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .reset-password-button:hover {
            background: #0056b3;
        }

        .reset-password-message {
            color: red;
            margin-bottom: 16px;
            text-align: center;
        }
    </style>
</head>

<body class="reset-password-page">
    <h1 class="reset-password-title">Đặt lại mật khẩu mới</h1>

    <% if (message) { %>
        <p class="reset-password-message">
            <%= message %>
        </p>
        <% } %>

            <form action="/admin/forgotPassword/resetPassword" method="POST" class="reset-password-form">
                <input type="hidden" name="email" value="<%= email %>" />
                <input type="password" name="password" placeholder="Mật khẩu mới" required
                    class="reset-password-input" />
                <input type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu" required
                    class="reset-password-input" />
                <button type="submit" class="reset-password-button">Đặt lại mật khẩu</button>
            </form>
</body>

</html>