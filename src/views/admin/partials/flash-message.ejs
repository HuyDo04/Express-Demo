<style>
    .flash-message {
        padding: 16px 20px;
        margin-bottom: 20px;
        border-radius: 20px;
        border: 1px solid #ccc;
        background: #ccc;
    }

    .flash-message.success {
        border-color: #a3cfbb;
        background: #a3cfbb;
    }

    .flash-message.errors {
        border-color: #842029;
        background: #842029;
    }

    .flash-message.warning {
        border-color: #ffda6a;
        background: #ffda6a;
    }
</style>

<% if(flash) { %>
    <div class="flash-message <%= flash.type %>">
        <%= flash.message %>
    </div>
<% } %>