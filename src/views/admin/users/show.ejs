<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create User</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="assets/css/common.css" />
    <style>
        .user-profile {
            display: flex;
            gap: 20px;
            margin-top: 20px;
        }

        .user-avatar {
            width: 200px;
            flex-shrink: 0;
        }

        .user-avatar img {
            width: 100%;
            border-radius: 8px;
        }

        .user-details {
            flex-grow: 1;
        }

        .user-details h2 {
            margin: 0;
        }

        .user-details p {
            margin: 5px 0;
            color: #555;
        }
    </style>
</head>

<body>
    <div class="app-container">
        <main class="content-wrapper">
            <div class="content-header">
                <h1>Chi tiết người dùng</h1>
                <div>
                    <a href="users.html" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                    <a href="/users/<%= user.id %>/edit" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Chỉnh sửa
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="user-profile">
                        <div class="user-avatar">
                            <img src="<%= user.avatar || 'https://example.com/default-avatar.png' %>"
                                alt="Avatar của <%= user.first_name %> <%= user.last_name %>" />
                        </div>
                        <div class="user-details">
                            <h2>
                                <%= user.first_name %>
                                    <%= user.last_name %>
                            </h2>
                            <p><strong>Username:</strong>
                                <%= user.username %>
                            </p>
                            <p><strong>Email:</strong>
                                <%= user.email %>
                            </p>
                            <p><strong>Giới tính:</strong>
                                <%= user.gender || 'Chưa cập nhật' %>
                            </p>
                           
                            <p><strong>Trạng thái:</strong>
                                <%= user.is_active ? 'Đang hoạt động' : 'Không hoạt động' %>
                            </p>
                            <p><strong>Giới thiệu:</strong>
                                <%= user.intro || 'Chưa cập nhật' %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>

</html>